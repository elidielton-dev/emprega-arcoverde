# Ambiente de Execução
NODE_ENV=development
APP_URL=http://localhost:3000

# Pooler transação (app e Vercel) — porta 6543
DATABASE_URL="postgresql://postgres.SEU_REF:[SUA-SENHA]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Pooler sessão (prisma db push / seed) — porta 5432
DIRECT_URL="postgresql://postgres.SEU_REF:[SUA-SENHA]@aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase (Auth OAuth + Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Escopos extras LinkedIn (opcional — só se o app tiver produto parceiro aprovado)
# Ex.: r_profile_basicinfo r_primary_current_experience r_most_recent_education
LINKEDIN_EXTRA_SCOPES=""
# Bucket privado no Storage (criar no painel Supabase)
STORAGE_BUCKET="emprega-arcoverde-docs"
# local | supabase (vazio = supabase se SERVICE_ROLE existir, senão disco ./uploads)
STORAGE_DRIVER=""

# Autenticação & JWT (obrigatório em produção)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# E-mail — Resend (preferencial)
# Crie a chave em https://resend.com/api-keys
# Em produção na Vercel: defina RESEND_API_KEY + EMAIL_FROM + APP_URL=https://seu-dominio
# Com onboarding@resend.dev o Resend só envia para o e-mail da sua conta Resend (teste).
# Para enviar a qualquer cidadão: verifique um domínio em resend.com/domains e use-o no EMAIL_FROM.
EMAIL_FROM="Emprega Arcoverde <onboarding@resend.dev>"
RESEND_API_KEY=""
# force mock: EMAIL_MOCK=true
EMAIL_MOCK=""

# SMTP legado (opcional — só se não usar Resend)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_PROVIDER_API_KEY=""

# Tarefas Agendadas (Cron)
CRON_SECRET="cron-secret-arcoverde-key-987654"

# Monitoramento
SENTRY_DSN=""

# WhatsApp oficial (desativado — produto usa só wa.me manual)
WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_PROVIDER_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Links wa.me (interesse de empresa / contato)
NEXT_PUBLIC_WHATSAPP_ACA="558738211234"
NEXT_PUBLIC_WHATSAPP_PREFEITURA="558738219000"
