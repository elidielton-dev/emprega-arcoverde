# Ambiente de Execução
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco de Dados PostgreSQL (Docker local: docker compose up -d)
# Na Vercel, use o Postgres do Supabase (Session pooler, porta 6543):
# postgresql://postgres.[ref]:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emprega_arcoverde"

# Supabase Auth (Google e LinkedIn)
# Project Settings > API: Project URL e anon public key
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Authentication > URL Configuration: http://localhost:3000/auth/callback
# Authentication > Providers: Google e LinkedIn (OIDC)

# Autenticação & JWT
AUTH_SECRET="emprega-arcoverde-super-secret-jwt-key-2026"

# E-mail Transacional (Mock em dev / Resend/SMTP em prod)
EMAIL_FROM="nao-responda@emprega.arcoverde.pe.gov.br"
EMAIL_PROVIDER_API_KEY=""

# Armazenamento Seguro de Documentos (Mock local em dev / S3 compatível em prod)
STORAGE_ENDPOINT=""
STORAGE_REGION="sa-east-1"
STORAGE_BUCKET="emprega-arcoverde-docs"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Tarefas Agendadas (Cron)
CRON_SECRET="cron-secret-arcoverde-key-987654"

# Monitoramento
SENTRY_DSN=""

# Integração Oficial de WhatsApp (Desativada por padrão)
WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_PROVIDER_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
